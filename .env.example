# Copy to .env.local for local development
# Backend API (bunun_backend). Only the admin server talks to it; the browser never does.
API_URL=http://localhost:4000
# Public storefront address (links to products and the track page)
STOREFRONT_URL=http://localhost:3000

# Error tracking (Sentry, free plan): sentry.io -> project -> Client Keys (DSN). Off when empty.
NEXT_PUBLIC_SENTRY_DSN=
# e.g. staging or production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
