{
  "name": "bunun-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Bunun store admin panel (Next.js)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
